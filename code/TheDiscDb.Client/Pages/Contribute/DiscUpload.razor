@inherits CancellableComponentBase
@page "/contribution/{contributionId}/discs/{discId}"
@using HighlightBlazor

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@if (contribution is not null)
{
    <TheDiscDb.Client.Controls.Breadcrumb PrimaryText="Upload Disc Logs" Items="[
        GetRootContributionLink(),
        GetContributionLink(contribution)
    ]" />

    <div class="contribute-layout disc-upload-page">
        <section class="contribute-hero compact">
            <p class="eyebrow">Upload Logs</p>
            <h1>@contribution.Title (@contribution.Year)</h1>
            <p>Provide a disc scan, a MakeMKV log, or an Optical Disc Manifest for this disc so we can analyze the structure and allow you to identify items.</p>
        </section>

        @if (!string.IsNullOrEmpty(uploadError))
        {
            <div class="upload-error-banner">
                <div class="alert alert-danger" role="alert">
                    <strong>Upload failed:</strong> @uploadError
                </div>
                <button class="btn btn-secondary" @onclick="ResetError">Try again</button>
            </div>
        }
        else if (showSpinner && !IsScanTab)
        {
            <div class="log-status">
                <div class="lds-ripple" title="Checking for logs"><div></div><div></div></div>
                <div>
                    <strong>Checking for logs…</strong>
                    <p>The page will refresh automatically once the upload finishes.</p>
                </div>
            </div>
        }

        @if (showOptionalScanPanel)
        {
            <section class="info-card optional-scan-panel">
                <p class="eyebrow">Optional</p>
                <h2>Also scan this disc</h2>
                <p>
                    Your MakeMKV log is uploaded. If you can also scan the disc in your browser,
                    we can compare both results and use that data to replace MakeMKV logs in the future.
                    Scan warnings never block your contribution.
                </p>
                @if (!string.IsNullOrEmpty(scanNotice))
                {
                    <div class="alert alert-info">@scanNotice</div>
                }
                <div class="cta-row">
                    <button class="btn btn-primary" @onclick="ScanDiscAsync" disabled="@isScanning">
                        @(isScanning ? "Scanning Disc..." : "Scan disc")
                    </button>
                    <button class="btn btn-secondary" @onclick="SkipAndIdentify" disabled="@isScanning">Skip and identify</button>
                    @if (showContinueToIdentify)
                    {
                        <button class="btn btn-outline-primary" @onclick="ContinueToIdentify">Continue to identify</button>
                    }
                </div>
                <DiscScanPanel IsScanning="isScanning"
                               ScanProgress="@scanProgress"
                               ScanWarnings="scanWarnings"
                               ScanUploadSucceeded="scanUploadSucceeded"
                               IsDefaultMode="IsDefaultMode"
                               ButtonText="Scan disc"
                               OnScanDisc="ScanDiscAsync" />
            </section>
        }

        <section class="info-card upload-instructions">
            <h2>Choose how you want to upload</h2>
            <SfTab @bind-SelectedItem="selectedIndex">
                <TabAnimationSettings>
                    <TabAnimationPrevious Effect="Syncfusion.Blazor.AnimationEffect.None" />
                    <TabAnimationNext Effect="Syncfusion.Blazor.AnimationEffect.None" />
                </TabAnimationSettings>
                <TabItems>
                    @if (IsDefaultMode)
                    {
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Scan Disc" />
                            </ChildContent>
                            <ContentTemplate>
                                <DiscScanPanel IsScanning="isScanning"
                                               ScanProgress="@scanProgress"
                                               ScanWarnings="scanWarnings"
                                               ScanUploadSucceeded="scanUploadSucceeded"
                                               IsDefaultMode="IsDefaultMode"
                                               OnScanDisc="ScanDiscAsync" />
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Advanced: MakeMKV log" />
                            </ChildContent>
                            <ContentTemplate>
                                <AdvancedMakeMkvUpload PowershellCommand="@PowershellCommand"
                                                       BashCommand="@BashCommand"
                                                       @bind-DriveIndex="DriveIndex"
                                                       DriveIndices="driveIndices"
                                                       OnCopyPowerShell="CopyPowerShellCommand"
                                                       OnCopyBash="CopyBashCommand"
                                                       OnLogValueChange="ValueChange"
                                                       OnManifestValueChange="ManifestValueChange" />
                            </ContentTemplate>
                        </TabItem>
                    }
                    else
                    {
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="PowerShell" />
                            </ChildContent>
                            <ContentTemplate>
                                <CodeHighlight CodeLanguage="PowerShell" Code="@PowershellCommand" />
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Bash" />
                            </ChildContent>
                            <ContentTemplate>
                                <CodeHighlight CodeLanguage="Bash" Code="@BashCommand" />
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Manual Upload" />
                            </ChildContent>
                            <ContentTemplate>
                                <div class="manual-upload">
                                    <p>Have a log file already? Upload the <code>.txt</code> output directly.</p>
                                    <SfUploader AllowMultiple="false" AutoUpload="true" AllowedExtensions=".txt" ShowFileList="false">
                                        <UploaderEvents ValueChange="ValueChange" />
                                    </SfUploader>
                                </div>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Disc Manifest" />
                            </ChildContent>
                            <ContentTemplate>
                                <div class="manual-upload">
                                    <p>Have an Optical Disc Manifest? Upload the <code>.odm.json</code> file.</p>
                                    <SfUploader AllowMultiple="false" AutoUpload="true" AllowedExtensions=".json" ShowFileList="false">
                                        <UploaderEvents ValueChange="ManifestValueChange" />
                                    </SfUploader>
                                </div>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent>
                                <TabHeader Text="Scan Disc" />
                            </ChildContent>
                            <ContentTemplate>
                                <DiscScanPanel IsScanning="isScanning"
                                               ScanProgress="@scanProgress"
                                               ScanWarnings="scanWarnings"
                                               ScanUploadSucceeded="scanUploadSucceeded"
                                               IsDefaultMode="IsDefaultMode"
                                               OnScanDisc="ScanDiscAsync" />
                            </ContentTemplate>
                        </TabItem>
                    }
                </TabItems>
            </SfTab>

            @if (IsCommandTab)
            {
                <button class="btn btn-primary copy-command" @onclick="CopyTextToClipboard" disabled="@state.IsDisabled">
                    <i class="@state.IconClassName"></i>
                    <span>@state.Text</span>
                </button>

                <section class="info-card">
                    <h2>Select drive</h2>
                    <p class="helper-text">If you have multiple drives, choose the index where the disc is mounted. This value is injected into the command below. Most users do not need to change this.</p>
                    <div class="form-control-block">
                        <SfDropDownList TValue="string" TItem="string" DataSource="driveIndices" class="form-control" @bind-Value="DriveIndex" Placeholder="Select drive index" />
                    </div>
                </section>
            }
        </section>
    </div>
}
else
{
    <div class="contribute-layout">
        <section class="contribute-hero compact">
            <h1>Disc not found</h1>
            <p>We couldn’t load the requested disc. Please return to the contribution overview.</p>
            <a class="btn btn-secondary" href="/contribution/@ContributionId">Back to contribution</a>
        </section>
    </div>
}
