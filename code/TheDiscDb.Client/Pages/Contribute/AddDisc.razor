@inherits CancellableComponentBase
@page "/contribution/{contributionId}/adddisc"

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@if (contribution is not null)
{
    <TheDiscDb.Client.Controls.Breadcrumb PrimaryText="Add Disc" Items="[
        GetRootContributionLink(),
        GetContributionLink(contribution)
    ]" />

    <div class="contribute-layout add-disc-page">
        <section class="contribute-hero compact">
            <p class="eyebrow">Add a Disc</p>
            <h1>@contribution.Title (@contribution.Year)</h1>
            <p>Ensure the disc you would like to add is in your optical drive.</p>
        </section>

        @if (!discSelected && !manualHashMode)
        {
            <section class="info-card">
                <p>
                    Insert the disc you want to add, then select its root folder (usually the drive letter). We’ll hash it to see if it already exists
                    in the database. Chrome and Edge use direct file-system access; Firefox and Safari use a folder selection fallback.
                </p>
                @if (!string.IsNullOrEmpty(copyFlowError))
                {
                    <div class="alert alert-warning">@copyFlowError</div>
                }
                <button class="btn btn-primary" @onclick="OpenFolderAsync" disabled="@isScanning">
                    @(isScanning ? "Reading Disc..." : "Select Disc Root Folder")
                </button>
                @if (isScanning)
                {
                    <div class="scan-status">
                        <LoadingIndicator Message="Reading disc and calculating identifiers…" />
                    </div>
                }
                @if (IsDevelopmentMode)
                {
                    <div class="manual-hash-section">
                        <p class="manual-hash-divider">— or —</p>
                        <p>Enter a disc content hash manually <strong>(development only)</strong>.</p>
                        <div class="manual-hash-input-row">
                            <input type="text" class="form-control" @bind="manualHash" @bind:event="oninput" placeholder="Enter content hash" />
                            <button type="button" class="btn btn-secondary" @onclick="SubmitManualHash" disabled="@string.IsNullOrWhiteSpace(manualHash)">Use Manual Hash</button>
                        </div>
                    </div>
                }
            </section>
        }
        else
        {
            <section class="info-card add-disc-form-card">
                @if (!string.IsNullOrEmpty(copyFlowError))
                {
                    <div class="alert alert-warning">@copyFlowError</div>
                }
                @if (intakeDiscMatch?.GlobalDiscIdMismatch == true)
                {
                    <div class="alert alert-warning">
                        No exact stored evidence set matched the Disc ID from your current physical scan. The latest matching-content scan set was used, and your newly scanned Disc ID will be kept for review.
                    </div>
                }
                <EditForm Model="@request" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid">
                        <div class="mb-3">
                            <label>Disc Format</label>
                            <SfDropDownList TValue="string" TItem="string" DataSource="formats" class="form-control" @bind-Value="request.Format" Placeholder="Select format" />
                            <ValidationMessage For="@(() => request.Format)" />
                        </div>

                        <div class="mb-3">
                            <label>Disc Title</label>
                            <InputText class="form-control" @bind-Value="request.Name" @oninput="DiscTitleChanged" />
                            <ValidationMessage For="@(() => request.Name)" />
                        </div>

                        <div class="mb-3">
                            <label>Disc Slug</label>
                            <HelpPopover AccessibleLabel="What is a disc slug?">
                                A disc slug is the URL-friendly name that identifies this specific disc within its release.
                                Use lowercase words separated by hyphens, such as <strong>bonus-features-disc</strong>.
                                Disc slugs must be unique within the release.
                            </HelpPopover>
                            <SlugInput @ref="slugInput" class="form-control" @bind-Value="request.Slug" CheckAvailability="CheckDiscSlugAvailability" />
                            <ValidationMessage For="@(() => request.Slug)" />
                            @if (DiscNamingSuggestion is { } suggestion)
                            {
                                <ContributionNamingSuggestion EntityName="disc"
                                                              NameLabel="title"
                                                              SuggestedName="@suggestion.SuggestedName"
                                                              SuggestedSlug="@suggestion.SuggestedSlug"
                                                              OnApply="ApplyDiscNamingSuggestion" />
                            }
                        </div>
                    </div>

                    <div class="cta-row split">
                        <a class="btn btn-secondary" href="/contribution/@ContributionId">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Disc</button>
                    </div>
                </EditForm>
            </section>
        }
    </div>
}
else
{
    <div class="contribute-layout">
        <section class="contribute-hero compact">
            <h1>Loading...</h1>
        </section>
    </div>
}

<Syncfusion.Blazor.Popups.SfDialogProvider />
