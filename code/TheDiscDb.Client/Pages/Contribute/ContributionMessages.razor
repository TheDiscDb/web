@inherits MessageConversationBase
@page "/contribution/{contributionId}/messages"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Messages</PageTitle>

<TheDiscDb.Client.Controls.Breadcrumb PrimaryText="Messages" Items="@breadcrumbItems" />

<div class="contribute-layout">
    <div class="page-header">
        <h1>Messages</h1>
        <div class="page-header__sub">@(isAdmin ? "Review contributor messages and reply on behalf of the administrator team." : "View messages from admins and send replies about your contribution.")</div>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (loadError != null && chatItems.Count == 0)
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else
    {
        <section class="info-card">
            <h3>Conversation</h3>
            <TheDiscDb.Client.Controls.MessageTimeline Messages="chatItems" ViewerId="@viewerId" />
            @if (hasOlder)
            {
                <button class="btn btn-outline-secondary" @onclick="LoadOlder" disabled="@isLoadingOlder">@(isLoadingOlder ? "Loading..." : "Load older messages")</button>
            }
            @if (loadError != null)
            {
                <div class="alert alert-danger">@loadError</div>
            }
            @if (readError != null)
            {
                <div class="alert alert-warning">@readError <button class="btn btn-sm btn-outline-secondary" @onclick="RetryAcknowledgement">Retry</button></div>
            }
        </section>

        <section class="info-card">
            <h3>Send a Message</h3>
            <div class="mb-3">
                <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm @(showPreview ? "btn-outline-secondary" : "btn-secondary")" @onclick="() => showPreview = false">Write</button>
                    <button class="btn btn-sm @(showPreview ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => showPreview = true">Preview</button>
                </div>

                @if (showPreview)
                {
                    <div class="form-control markdown-preview">
                        @((MarkupString)RenderMarkdown(newMessage))
                    </div>
                }
                else
                {
                    <textarea class="form-control" rows="4" placeholder="Type your message... (markdown supported)" @bind="newMessage" @bind:event="oninput"></textarea>
                }
            </div>
            <button class="btn btn-primary" @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(newMessage) || isSending)">
                @if (isSending)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                Send Message
            </button>
            @if (!string.IsNullOrEmpty(sendError))
            {
                <div class="alert alert-danger mt-2">@sendError</div>
            }
        </section>
    }
</div>
