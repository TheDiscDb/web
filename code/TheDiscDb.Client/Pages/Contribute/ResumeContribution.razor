@page "/contribute/resume"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<div class="contribute-layout">
    <h1>Continue your contribution</h1>
    @if (error is null)
    {
        <LoadingIndicator Message="Saving your scan to your account..." />
    }
    else
    {
        <div class="alert alert-danger" role="alert">@error</div>
        <div class="cta-row">
            <button class="btn btn-primary" @onclick="ResumeAsync">Retry</button>
            <a class="btn btn-secondary" href="/contribute/scan">Back to scanning</a>
        </div>
    }
</div>
