<div class="folder-picker-fallback">
    <p class="fallback-message">
        <strong>Folder wouldn't open?</strong>
        <span>Try selecting it another way.</span>
    </p>
    <button type="button" class="btn fallback-button" @onclick="OnPickFolder" disabled="@Disabled">
        Try another folder picker
    </button>
</div>
