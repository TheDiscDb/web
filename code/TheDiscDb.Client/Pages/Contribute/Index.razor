@page "/contribute"
@using Microsoft.AspNetCore.Components.Authorization

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<TheDiscDb.Client.Controls.Breadcrumb PrimaryText="Contribute" Items='[("Home", "/")]' />

<div class="contribute-layout">
    <div class="page-header">
        <h1>Contribute to <span class="page-header__accent">TheDiscDb</span></h1>
        <div class="page-header__sub">Thank you for contributing — we'll step you through the process</div>
    </div>

    @if (DiscFirstFlow)
    {
        <section class="callout scanning-announcement">
            <span class="scanning-announcement-badge">New</span>
            <div>
                <h2>Introducing disc-first contributions</h2>
                <p>
                    Contributions now start with your disc. Scan it directly in your browser &mdash; no MakeMKV logs required.
                    Scans use the new <a href="https://github.com/TheDiscDb/optical-disc-manifest" target="_blank" rel="noopener noreferrer">Optical Disc Manifest</a> format.
                </p>
                <p>
                    Tried the new flow? <a href="https://github.com/orgs/TheDiscDb/discussions/1476" target="_blank" rel="noopener noreferrer">Share your feedback</a> and help us improve it.
                </p>
            </div>
        </section>
    }

    <section class="step-section contribute-start">
        <h2>Ready to Start?</h2>
        @if (DiscFirstFlow)
        {
            <DiscScanStart ButtonCssClass="contribute-start-button">
                <ButtonContent>
                    Select a disc to get started <i class="e-icons e-arrow-right contribute-start-arrow" aria-hidden="true"></i>
                </ButtonContent>
            </DiscScanStart>
        }
        else
        {
            <div class="cta-row">
                <a class="btn btn-primary" href="/contribute/Movie">Contribute a Movie</a>
                <a class="btn btn-primary" href="/contribute/Series">Contribute a Series / TV Show</a>
                <a class="btn btn-secondary" href="/contribute/boxset/create">Create a Boxset</a>
            </div>
        }
        <p class="contribute-start-help">
            You’ll need a disc drive, @(DiscFirstFlow ? "a current desktop browser" : "MakeMKV"), and the release’s UPC, ASIN, release date, and cover images.
            <a href="/help/contributing#what-youll-need">See what you’ll need</a> or
            <a href="/help/contributing">read the contributing guide</a>.
        </p>
    </section>

    @if (this.PendingContributions != null && this.PendingContributions.Any())
    {
        <section class="info-card pending-contributions-card">
            <h2>
                <span class="pending-contributions-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                        <path d="M12 3c.33 0 .64.17.82.45l8.38 13.73c.21.34.22.78.01 1.13-.2.35-.57.57-.97.57H3.76c-.4 0-.77-.22-.97-.57-.21-.35-.2-.79.01-1.13L11.18 3.45A.96.96 0 0 1 12 3zm0 3.4L5.42 17.6h13.16L12 6.4zm-1 3.6h2v4.5h-2zm0 5.75h2V19h-2z" />
                    </svg>
                </span>
                Pending Contributions
            </h2>
            <p>You are almost there! It looks like you have some contributions that are still pending. <a href="/contribute/my?status=pending">View your pending contributions</a> to keep working towards finishing them.</p>
        </section>
    }

    <section class="callout">
        <h3>Need a hand?</h3>
        <p>
            Email us at <a href="mailto:web@thediscdb.com">web@thediscdb.com</a> or create a discussion on <a href="https://github.com/orgs/TheDiscDb/discussions" target="_blank" rel="noopener noreferrer">Github</a>.
        </p>
    </section>

    <nav class="contribution-community-links" aria-label="Contribution community">
        <a class="btn btn-outline-secondary" href="/contributions/stats">
            <i class="e-icons e-chart" aria-hidden="true"></i>
            Contribution stats
        </a>
        <a class="btn btn-outline-secondary" href="/leaderboard">
            <i class="e-icons e-people" aria-hidden="true"></i>
            Contributor leaderboard
        </a>
    </nav>
</div>
