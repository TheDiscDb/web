@namespace TheDiscDb.Client.Controls

@if (Messages.Count > 0)
{
    <div class="history-timeline">
        @foreach (var item in Messages)
        {
            <div @key="item.Id" class="history-item history-type-@item.Type.ToString().ToLowerInvariant()">
                <div class="history-header">
                    <span class="history-type badge @(item.Type == Contributions.UserMessageType.AdminMessage ? "bg-primary" : "bg-secondary")">@GetSenderLabel(item, ViewerId)</span>
                    <span class="history-time">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                </div>
                <div class="history-body">
                    @((MarkupString)RenderMarkdown(item.Message))
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No messages yet.</p>
}
