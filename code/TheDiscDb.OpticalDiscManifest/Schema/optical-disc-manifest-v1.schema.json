{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thediscdb.com/optical-disc-manifest/v1/optical-disc-manifest.schema.json",
  "title": "Optical Disc Manifest v1",
  "description": "A tool-neutral manifest of observed DVD, Blu-ray, or UHD Blu-ray structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "disc"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "disc": {
      "$ref": "#/$defs/disc"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "disc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "identifiers"
      ],
      "properties": {
        "format": {
          "enum": [
            "dvd",
            "blu-ray",
            "uhd-blu-ray",
            "unknown"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "identifiers": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "thediscdb-content-hash"
              }
            },
            "required": [
              "kind"
            ]
          },
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "titles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/title"
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "aacs-disc-id",
            "dvd-disc-id",
            "matrix256",
            "thediscdb-content-hash"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{32,128}$"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "modifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/titleSource"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stream"
          }
        },
        "stereoscopic3D": {
          "$ref": "#/$defs/stereoscopicView"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "titleSource": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "pattern": "^BDMV/(BACKUP/)?PLAYLIST/[^/]+\\.[Mm][Pp][Ll][Ss]$"
            }
          ]
        },
        "title": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "titleSet": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "titleSetTitle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startSeconds"
      ],
      "properties": {
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip"
      ],
      "properties": {
        "clip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "angle": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "codec"
      ],
      "properties": {
        "type": {
          "enum": [
            "video",
            "audio",
            "subtitle",
            "menu",
            "data",
            "unknown"
          ]
        },
        "category": {
          "enum": [
            "video",
            "secondaryVideo",
            "audio",
            "secondaryAudio",
            "presentationGraphics",
            "interactiveGraphics",
            "dolbyVisionVideo",
            "pictureInPicturePresentationGraphics",
            "subpicture"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8191
        },
        "codingTypeCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "formatCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rateCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "dynamicRangeTypeCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "colorSpaceCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "hdrPlusFlag": {
          "type": "boolean"
        },
        "line21ClosedCaptionFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [1, 2]
          }
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "languageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "audioLayout": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "aspectRatio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "frameRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "isInterlaced": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "stereoscopicView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipType",
        "baseClipId",
        "dependentClipId"
      ],
      "properties": {
        "relationshipType": {
          "const": "3d-dependent-view"
        },
        "baseClipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "baseCodecId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "baseStcId": {
          "type": "integer",
          "minimum": 0
        },
        "dependentClipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "dependentCodecId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "dependentStcId": {
          "type": "integer",
          "minimum": 0
        },
        "syncPlayItemId": {
          "type": "integer",
          "minimum": 0
        },
        "syncPresentationTimestampTicks45k": {
          "type": "integer",
          "minimum": 0
        },
        "isSsVideoSubPath": {
          "type": "boolean"
        },
        "dependentStream": {
          "$ref": "#/$defs/stereoscopicDependentStream"
        }
      }
    },
    "stereoscopicDependentStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codingTypeCode",
        "codec"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8191
        },
        "codingTypeCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "formatCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rateCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clipId"
      ],
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "streamPath": {
          "$ref": "#/$defs/path"
        },
        "clipInfoPath": {
          "$ref": "#/$defs/path"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "numberOfSourcePackets": {
          "type": "integer",
          "minimum": 0
        },
        "transportStreamRecordingRate": {
          "type": "integer",
          "minimum": 0
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stream"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+(?:/[A-Za-z0-9._~-]+)+$"
      },
      "additionalProperties": true
    }
  }
}
