@using TheDiscDb.Services.Admin

<section class="info-card">
    <h2>@Title</h2>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Group</th>
                <th>Identify matches / measured</th>
                <th>Identify rate</th>
                <th>Not comparable / not measured</th>
                <th>Technical matches</th>
                <th>Technical rate</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr @key="row.Label">
                    <td>@row.Label</td>
                    <td>@row.IdentifyExperience.Matches / @row.IdentifyExperience.Measured</td>
                    <td>@row.IdentifyExperience.Rate</td>
                    <td>@row.IdentifyExperience.NotComparable / @row.IdentifyExperience.NotMeasured</td>
                    <td>@row.Stats.Matches / @row.Stats.Total</td>
                    <td>@FormatRate(row.Stats)</td>
                </tr>
            }
        </tbody>
    </table>
</section>
