@page "/admin/disc-scan-parity"
@using TheDiscDb.Services.Admin

@rendermode InteractiveServer

<PageTitle>Admin - Disc scan parity</PageTitle>

<TheDiscDb.Client.Controls.Breadcrumb Items="[GetRootAdminLink()]" PrimaryText="Disc scan parity" />

<h1>Disc scan parity</h1>
<p class="text-muted">Latest MakeMKV log vs browser disc scan comparison per contribution disc.</p>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <label for="producer-version" class="form-label">Producer version</label>
        <select id="producer-version" class="form-select" @bind="selectedProducerVersion">
            <option value="">All versions</option>
            @if (dashboard != null)
            {
                @foreach (var version in dashboard.ProducerVersions)
                {
                    <option value="@version">@version</option>
                }
            }
        </select>
    </div>
    <div class="col-md-8 parity-actions">
        <button type="button" class="btn btn-primary" @onclick="ApplyFilterAsync">Apply filter</button>
        <button type="button" class="btn btn-outline-primary ms-2" @onclick="RecompareAllAsync" disabled="@isRecompareAllRunning">
            @(isRecompareAllRunning ? "Re-comparing..." : "Re-compare all")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-info">@statusMessage</div>
}

@if (dashboard == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <section class="info-card mb-3">
        <h2>Useful content (metadata v1)</h2>
        <p>@dashboard.UsefulContent.Summary</p>
        <p class="text-muted">@TheDiscDb.Contributions.OpticalDiscManifest.UsefulContentComparison.Scope</p>
        <p>Saved identifications are counted conservatively unless explicitly classified incidental.
            No useful-reference labels is not a pass. These measurements do not replace the rollout gate.</p>
        <h2>Identify similarity (graded v1)</h2>
        <p>@dashboard.Similarity.Summary</p>
        <p>@TheDiscDb.Contributions.OpticalDiscManifest.IdentifySimilarityScore.Formula.
            Arithmetic mean of measured per-disc scores, not pooled rows; unmeasured discs excluded, not treated as 0% or 100%.</p>
        <p>@TheDiscDb.Contributions.OpticalDiscManifest.IdentifySimilarityScore.Scope</p>
        <h2>Same identify experience</h2>
        <p class="parity-rate">@dashboard.IdentifyExperience.Rate</p>
        <p>@dashboard.IdentifyExperience.Matches of @dashboard.IdentifyExperience.Measured measured comparisons match;
            @dashboard.IdentifyExperience.NotComparable not comparable; @dashboard.IdentifyExperience.NotMeasured not measured.</p>
        <p class="text-muted">@TheDiscDb.Contributions.OpticalDiscManifest.IdentifyExperienceComparison.ScopeText</p>
        <p>Older comparisons need a new comparison to measure this metric. Technical parity remains separate below.</p>
        <h3>Technical parity</h3>
        <p class="parity-rate">@FormatRate(dashboard.Overall) match rate</p>
        <p>@dashboard.Overall.Matches of @dashboard.Overall.Total latest comparisons match.</p>
    </section>

    <div class="parity-breakdowns">
        <DiscScanParityBreakdownTable Title="By format" Rows="dashboard.ByFormat" />
        <DiscScanParityBreakdownTable Title="By producer version" Rows="dashboard.ByProducerVersion" />
        <DiscScanParityBreakdownTable Title="By MakeMKV version" Rows="dashboard.ByMakeMkvVersion" />
        <DiscScanParityBreakdownTable Title="By browser" Rows="dashboard.ByBrowser" />
    </div>

    <section class="info-card mt-3">
        <h2>Identify experience: differences and missing measurements</h2>
        @if (dashboard.IdentifyExperienceNonMatches.Count == 0)
        {
            <p>No differences or missing measurements.</p>
        }
        else
        {
            <QuickGrid Items="dashboard.IdentifyExperienceNonMatches.AsQueryable()" Class="striped-grid">
                <TemplateColumn Title="Disc">
                    <a href="/admin/disc-scan-parity/@context.DiscId">@context.ReleaseTitle - @context.DiscName</a>
                </TemplateColumn>
                <PropertyColumn Property="@(item => item.IdentifyExperienceLabel)" Title="Identify experience" />
                <PropertyColumn Property="@(item => item.IdentifySimilarityLabel)" Title="Graded similarity / components" />
                <PropertyColumn Property="@(item => item.Status)" Title="Technical parity" />
                <PropertyColumn Property="@(item => item.ComparedAt)" Title="Compared" Format="yyyy-MM-dd HH:mm" />
            </QuickGrid>
        }
    </section>

    <section class="info-card mt-3">
        <h2>Technical parity: non-matching latest comparisons</h2>
        @if (dashboard.NonMatches.Count == 0)
        {
            <p>All latest comparisons match.</p>
        }
        else
        {
            <QuickGrid Items="dashboard.NonMatches.AsQueryable()" Class="striped-grid">
                <TemplateColumn Title="Disc">
                    <a href="/admin/disc-scan-parity/@context.DiscId">@context.ReleaseTitle - @context.DiscName</a>
                </TemplateColumn>
                <PropertyColumn Property="@(item => item.Status)" Title="Status" />
                <PropertyColumn Property="@(item => item.IdentifySimilarityLabel)" Title="Graded similarity / components" />
                <PropertyColumn Property="@(item => item.Format)" Title="Format" />
                <PropertyColumn Property="@(item => item.ProducerVersion)" Title="Producer" />
                <PropertyColumn Property="@(item => item.MakeMkvVersion)" Title="MakeMKV" />
                <PropertyColumn Property="@(item => item.ComparedAt)" Title="Compared" Format="yyyy-MM-dd HH:mm" />
            </QuickGrid>
        }
    </section>
}
