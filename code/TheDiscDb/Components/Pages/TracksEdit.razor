@page "/{type}/{slug}/releases/{releaseSlug}/discs/{slugOrIndex}/{file}/{extension}/tracks/edit"
@page "/{type}/{slug}/releases/{releaseSlug}/discs/{slugOrIndex}/{file}/tracks/edit"
@page "/{type}/{slug}/discs/{slugOrIndex}/{file}/tracks/edit"
@page "/{type}/{slug}/discs/{slugOrIndex}/{file}/{extension}/tracks/edit"

@rendermode InteractiveServer
@inherits TheDiscDb.Components.AuthenticatedComponentBase

<PageTitle>Edit Track Names - TheDiscDb</PageTitle>

@if (Item == null || Release == null || Disc == null || Title == null)
{
    <div class="alert alert-warning">Tracks not found.</div>
}
else if (string.IsNullOrEmpty(Disc.Slug))
{
    <TheDiscDb.Client.Controls.Breadcrumb Items="@GetBreadcrumbs()" PrimaryText="Edit Track Names" />
    <div class="alert alert-info">Track editing isn't available for this disc.</div>
}
else
{
    <TheDiscDb.Client.Controls.Breadcrumb Items="@GetBreadcrumbs()" PrimaryText="Edit Track Names" />

    @if (!string.IsNullOrEmpty(submitMessage))
    {
        <div class="alert @(submitSuccess ? "alert-success" : "alert-danger")">@submitMessage</div>
    }

    @if (!isReviewing)
    {
        <h1>Suggest Track Names</h1>
        <p class="text-muted">
            Add or correct the name of an audio or subtitle track (for example
            "Director's commentary" or "Forced subtitles"). Other track fields come from the
            disc file metadata and can't be changed here. Your changes will be reviewed before
            being applied. Leave a name blank to remove it.
        </p>

        <section class="info-grid single-column">
            @{ var trackGroups = new[] { "Audio", "Subtitles" }; }
            @foreach (var groupType in trackGroups)
            {
                var groupRows = rows.Where(r => r.Track.IsTrackType(groupType)).OrderBy(r => r.Track.Index).ToList();
                if (groupRows.Count > 0)
                {
                    <h3 class="mt-4 mb-2">@groupType Tracks</h3>
                    <div class="table-responsive">
                        <table class="table striped-grid track-table mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" class="track-index">Index</th>
                                    <th scope="col">Track</th>
                                    <th scope="col">Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in groupRows)
                                {
                                    <tr>
                                        <td>@row.Track.Index</td>
                                        <td class="text-muted">@GetTrackContext(row.Track)</td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   aria-label="@($"{groupType} track {row.Track.Index} name")"
                                                   @bind="row.EditDescription" @bind:event="oninput" placeholder="Name (optional)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <div class="d-flex gap-2 mt-4">
                <button type="button" class="btn btn-primary" @onclick="ShowReview" disabled="@(!HasChanges())">
                    Review Suggested Changes
                </button>
                <a href="@GetTitleUrl()" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </section>
    }
    else
    {
        <h1>Review Your Track Names</h1>
        <p class="text-muted">These changes will be submitted for review by an admin.</p>

        <section class="info-grid single-column">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Track</th>
                        <th>Current Name</th>
                        <th>Proposed Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var diff in pendingDiffs)
                    {
                        <tr class="table-warning">
                            <td><strong>@diff.Type @diff.Index</strong> <span class="text-muted">@diff.Metadata</span></td>
                            <td class="text-muted">@(string.IsNullOrEmpty(diff.CurrentDescription) ? "—" : diff.CurrentDescription)</td>
                            <td><strong>@(string.IsNullOrEmpty(diff.ProposedDescription) ? "—" : diff.ProposedDescription)</strong></td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (pendingDiffs.Count == 0)
            {
                <div class="alert alert-info">No changes detected.</div>
            }

            @if (pendingDiffs.Count > 0)
            {
                <div class="mb-3">
                    <label for="track-edit-summary">Summary <span class="text-muted">(optional — briefly describe your changes)</span></label>
                    <input id="track-edit-summary" type="text" class="form-control" @bind="summary" />
                </div>
            }

            <div class="d-flex gap-2">
                @if (pendingDiffs.Count > 0 && !submitSuccess)
                {
                    <button type="button" class="btn btn-primary" disabled="@isSubmitting" @onclick="HandleSubmit">
                        @(isSubmitting ? "Submitting…" : "Submit Changes")
                    </button>
                }
                @if (!submitSuccess)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="BackToEdit">← Back to Edit</button>
                }
            </div>
        </section>
    }
}
