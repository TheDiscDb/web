@if (Entries.Count == 0)
{
    <p class="text-muted">No activity yet.</p>
}
else
{
    <div class="suggestion-timeline">
        @foreach (var entry in Entries.OrderBy(entry => entry.Timestamp))
        {
            <article class="suggestion-timeline__entry">
                <div class="suggestion-timeline__header">
                    <span class="badge @entry.BadgeClass">@entry.Label</span>
                    <span class="suggestion-timeline__actor">@entry.Actor</span>
                    <time datetime="@entry.Timestamp.ToString("O")">@entry.Timestamp.ToString("g")</time>
                </div>
                <TheDiscDb.Components.Controls.MarkdownContent Content="@entry.Content" />
            </article>
        }
    </div>
}
